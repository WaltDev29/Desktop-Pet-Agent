# 이 파일 이름을 .env로 수정하여 사용하세요.

# ============ LLM 설정 ============
USE_OPENAI=True
OPENAI_MODEL=gpt-4o-mini
API_KEY=your_openai_api_key_here

# ============ 로컬/대체 LLM 설정 (Ollama 등) ============
# USE_OPENAI가 False일 때 사용됩니다.
API_MODEL=MiniMax-M2.5-UD-Q3_K_XL-00001-of-00004.gguf
API_BASE_URL=http://your-local-llm-url/v1

# ============ Agent, Tool 서버 URL 설정 ============
# 고정값입니다. 수정할 경우 각 서버의 실행 Port도 변경해주어야 합니다.
AGENT_SERVER_URL=http://localhost:8001
API_SERVER=http://petagent.aikopo.net